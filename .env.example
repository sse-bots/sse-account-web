# ==============================================================================
# Central SSE Identity, 2-Step Verification & Badges Environment Variables
# ==============================================================================

# Public URL of this central auth website (no trailing slash)
BETTER_AUTH_URL=https://sse-account.vercel.app
NEXT_PUBLIC_APP_URL=https://sse-account.vercel.app

# 32+ byte random secret for signing sessions, cookies, JWTs & TOTP secrets
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# MongoDB Atlas connection string (same cluster as sse_bots_user is fine)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sse_accounts

# Discord OAuth2 App
# Redirect URI: https://sse-account.vercel.app/api/auth/callback/discord
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# GitHub OAuth App
# Callback URL: https://sse-account.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ==============================================================================
# Email Delivery (Required for Email OTP 2FA, Email Sign-In, Verification & Password Reset)
# Option A — Resend (recommended, free 3,000 emails/mo):
# ==============================================================================
RESEND_API_KEY=
EMAIL_FROM=SSE Accounts <onboarding@resend.dev>

# Option B — SMTP / Gmail App Password (leave RESEND_API_KEY blank to use SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Role & Admin Configuration
# Anyone matching ADMIN_DISCORD_ID / ADMIN_DISCORD_IDS / ADMIN_EMAILS gets "admin".
# Everyone else gets "member" by default. Define custom roles & badges in /admin.
# ==============================================================================
ADMIN_DISCORD_ID=your_discord_user_id
ADMIN_DISCORD_IDS=
OWNER_DISCORD_ID=
ADMIN_EMAILS=you@example.com

# Optional public links
NEXT_PUBLIC_SUPPORT_SERVER_INVITE=https://discord.gg/your-support-invite
NEXT_PUBLIC_NEXUS_URL=https://sse-nexus.vercel.app
NEXT_PUBLIC_TOURNAMENT_URL=
