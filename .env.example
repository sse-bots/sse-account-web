# ==============================================================================
# Central SSE Identity & OAuth 2.1 Provider Environment Variables
# ==============================================================================

# Public URL of this central auth website (no trailing slash)
BETTER_AUTH_URL=https://sse-account.vercel.app
NEXT_PUBLIC_APP_URL=https://sse-account.vercel.app

# 32+ byte random secret for signing sessions, cookies & JWTs
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=replace_with_a_long_random_secret

# MongoDB Atlas connection string (can be the SAME cluster as sse_bots_user)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Dedicated database name strictly for central accounts & OAuth clients
MONGODB_DB_NAME=sse_accounts

# Discord OAuth2 App (the ONLY place Discord OAuth credentials are needed!)
# Redirect URI in Discord Dev Portal:
#   https://sse-account.vercel.app/api/auth/callback/discord
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL in GitHub:
#   https://sse-account.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Admin access to /admin/oauth-clients and /admin/users
# Match by Discord User ID and/or comma-separated admin emails
OWNER_DISCORD_ID=your_discord_user_id
ADMIN_EMAILS=you@example.com

# Optional public links (can also be edited in src/lib/site-settings.ts)
NEXT_PUBLIC_SUPPORT_SERVER_INVITE=https://discord.gg/your-support-invite
NEXT_PUBLIC_NEXUS_URL=https://sse-nexus.vercel.app
NEXT_PUBLIC_TOURNAMENT_URL=
